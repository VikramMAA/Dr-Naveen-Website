---
import CallButton from './CallButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site, hospitalShort } from '../config/site';
interface Props {
  heading?: string;
  text?: string;
}
const { heading = 'Book a consultation', text = `Call to book an appointment with ${site.name} at ${hospitalShort}.` } = Astro.props;
---

<section class="call-panel no-print" aria-labelledby="call-panel-heading">
  <h2 id="call-panel-heading">{heading}</h2>
  <p>{text}</p>
  <div class="button-row">
    <CallButton />
    <WhatsAppButton />
  </div>
  <p class="call-panel__note">
    {site.familyConsultLine} <a href="/contact">Contact details</a>
  </p>
</section>

<style>
  .call-panel {
    margin-top: var(--space-5);
    background: var(--teal-tint);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-3);
    max-width: 820px;
  }
  .call-panel h2 {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }
  .call-panel__note {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-small);
  }
</style>
