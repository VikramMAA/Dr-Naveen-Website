---
interface Props {
  as?: 'div' | 'article' | 'li';
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['card', className]}><slot /></Tag>

<style>
  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }
  .card :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
