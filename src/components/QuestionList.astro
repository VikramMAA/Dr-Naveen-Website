---
interface Props {
  items: { question: string; why: string }[];
}
const { items } = Astro.props;
---

<ol class="question-list">
  {
    items.map((item, i) => (
      <li>
        <span class="question-list__num" aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <h3 class="question-list__q">{item.question}</h3>
          <p class="question-list__why">
            <strong>Why ask:</strong> {item.why}
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .question-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-3);
    max-width: 820px;
  }
  .question-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }
  .question-list__num {
    font-size: clamp(2.75rem, 2.2rem + 2vw, 3.75rem);
    font-weight: 800;
    line-height: 1;
    color: var(--teal);
    min-width: 1.4ch;
  }
  .question-list__q {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }
  .question-list__why {
    margin: 0;
  }
</style>
