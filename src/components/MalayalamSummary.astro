---
/** Malayalam summary. Hidden until site.showMalayalam is true (native speaker and Dr Naveen review pending). */
import { site } from '../config/site';
interface Props {
  text?: string;
}
const { text } = Astro.props;
---

{
  site.showMalayalam && text && (
    <section class="ml-summary" aria-label="Malayalam summary">
      <p class="ml-summary__label">മലയാളത്തിൽ</p>
      <p lang="ml">{text}</p>
    </section>
  )
}

<style>
  .ml-summary {
    background: var(--teal-tint);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-top: var(--space-5);
    max-width: 820px;
  }
  .ml-summary__label {
    font-weight: 800;
    color: var(--teal-dark);
    margin-bottom: 0.5rem;
  }
  .ml-summary p:last-child {
    margin: 0;
  }
</style>
