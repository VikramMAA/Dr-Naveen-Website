---
import { site } from "@/config/site";

interface Props {
  text: string;
}
const { text } = Astro.props;
if (!site.showMalayalam) return null;
---

{site.showMalayalam && (
  <div class="malayalam-summary">
    <p class="malayalam-summary__label">സംഗ്രഹം (Summary in Malayalam)</p>
    <p lang="ml" class="malayalam-summary__text">{text}</p>
  </div>
)}

<style>
  .malayalam-summary {
    background: var(--teal-tint);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .malayalam-summary__label {
    margin: 0 0 var(--space-2);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--teal-dark);
  }

  .malayalam-summary__text {
    margin: 0;
    color: var(--navy);
  }
</style>
