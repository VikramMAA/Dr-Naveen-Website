---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="checklist">
  {items.map((item) => (
    <li>
      <span class="checklist__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <circle cx="12" cy="12" r="12" fill="var(--teal)" />
          <path
            d="M7 12.5l3.2 3.2L17 9"
            fill="none"
            stroke="var(--white)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style>
  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .checklist__icon {
    flex: 0 0 auto;
    margin-top: 2px;
  }
</style>
