---
/**
 * Two fixed columns. A real table from 768px; on phones each row stacks,
 * with the column name shown above each cell so it stays readable.
 */
interface Props {
  caption: string;
  columns: [string, string];
  rows: { label: string; cells: [string, string] }[];
}
const { caption, columns, rows } = Astro.props;
---

<div class="compare">
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <td></td>
        <th scope="col">{columns[0]}</th>
        <th scope="col">{columns[1]}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td data-label={columns[0]}>{row.cells[0]}</td>
            <td data-label={columns[1]}>{row.cells[1]}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .compare {
    margin-block: var(--space-4);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    table-layout: fixed;
  }
  thead th {
    background: var(--navy);
    color: var(--offwhite);
    text-align: left;
    padding: 1rem 1.1rem;
    font-size: 1.125rem;
    line-height: 1.3;
    vertical-align: bottom;
  }
  thead td {
    background: var(--navy);
    width: 22%;
  }
  tbody th {
    text-align: left;
    vertical-align: top;
    padding: 1rem 1.1rem;
    background: var(--teal-tint);
    font-weight: 800;
  }
  tbody td {
    vertical-align: top;
    padding: 1rem 1.1rem;
    font-size: 1.0625rem;
  }
  tbody tr + tr > * {
    border-top: 1px solid var(--line);
  }
  tbody td + td {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 767.98px) {
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }
    table {
      border: 0;
      background: transparent;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    tbody tr {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: var(--space-2);
    }
    tbody tr + tr > * {
      border-top: 0;
    }
    tbody th {
      font-size: 1.25rem;
    }
    tbody td + td {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    tbody td::before {
      content: attr(data-label);
      display: block;
      font-weight: 800;
      color: var(--teal-dark);
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
