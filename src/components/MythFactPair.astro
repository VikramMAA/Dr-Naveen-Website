---
interface Props {
  myth: string;
  fact: string;
}
const { myth, fact } = Astro.props;
---

<div class="myth-fact">
  <div class="myth-fact__row myth-fact__row--myth">
    <span class="pill pill--myth">Myth</span>
    <p>{myth}</p>
  </div>
  <div class="myth-fact__row myth-fact__row--fact">
    <span class="pill pill--fact">Fact</span>
    <p>{fact}</p>
  </div>
</div>

<style>
  .myth-fact {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4);
    max-width: var(--measure);
  }
  .myth-fact__row {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .myth-fact__row p {
    margin: 0;
    font-size: var(--fs-lead);
    font-weight: 700;
    line-height: 1.4;
  }
  .myth-fact__row--myth p {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--muted);
  }
  /* Same position and size for both pills. 19px+ bold text = large text for contrast. */
  .pill {
    display: inline-block;
    min-width: 6.5rem;
    text-align: center;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 1.1875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .pill--myth {
    background: var(--amber);
    color: var(--navy);
  }
  .pill--fact {
    background: var(--teal);
    color: var(--white);
  }
</style>
