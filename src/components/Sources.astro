---
interface Props {
  sources: { label: string; url: string }[];
}
const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sources print-urls" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ul>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .sources {
    margin-top: var(--space-5);
    font-size: var(--fs-small);
  }
  .sources h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .sources ul {
    padding-left: 1.2em;
    margin: 0;
  }
  .sources li + li {
    margin-top: 0.15rem;
  }
  .sources a {
    display: inline-block;
    padding-block: 0.55rem;
  }
</style>
