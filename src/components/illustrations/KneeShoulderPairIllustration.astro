---
// Simple paired line drawing of a knee and a shoulder, used on the home
// page. Navy outline strokes, teal fill for the highlighted joints.
interface Props {
  title?: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 420 220"
  fill="none"
  stroke="var(--navy)"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  class={className}
>
  {title && <title>{title}</title>}

  <!-- Shoulder, left -->
  <path d="M20 150c4-40 28-78 60-92 10-5 20-5 28 2" />
  <path d="M138 150c-6-42-32-84-66-98" />
  <circle cx="64" cy="70" r="24" fill="var(--teal-tint)" />
  <circle cx="64" cy="70" r="13" fill="var(--teal)" stroke="var(--navy)" />
  <path d="M24 150v30M124 150v30" />

  <!-- Divider -->
  <path d="M200 20v180" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="2 6" />

  <!-- Knee, right -->
  <path d="M300 10c-10 32-13 62-5 86-10 14-11 30-2 44-6 24-6 54 0 80" />
  <path d="M360 10c10 32 14 62 7 86 11 14 12 30 2 44 6 24 6 54 0 80" />
  <path d="M322 100l10 14 10-14" fill="var(--teal-tint)" stroke="none" />
  <path d="M312 92l20 26 20-26" />
</svg>
