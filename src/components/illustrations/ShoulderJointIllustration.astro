---
// Simple line drawing of a shoulder joint. Navy outline, teal fill for the
// joint capsule. Decorative by default; pass `title` to make it meaningful.
interface Props {
  title?: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 200"
  fill="none"
  stroke="var(--navy)"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  class={className}
>
  {title && <title>{title}</title>}
  <path d="M30 150c4-40 28-80 60-96 10-5 20-5 28 2" />
  <path d="M170 150c-6-42-32-84-66-98" />
  <circle cx="96" cy="70" r="26" fill="var(--teal-tint)" />
  <circle cx="96" cy="70" r="14" fill="var(--teal)" stroke="var(--navy)" />
  <path d="M46 150v34M152 150v34" />
  <path d="M60 80c-10 6-18 16-20 30" />
</svg>
