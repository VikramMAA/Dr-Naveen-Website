---
/**
 * Lite YouTube embed. Shows a thumbnail and a play button. The privacy-enhanced
 * youtube-nocookie.com iframe loads only after a click. With no ID, a "Coming soon" card.
 */
import Icon from './Icon.astro';

interface Props {
  id?: string;
  title?: string;
  language?: string;
  headingLevel?: 'h2' | 'h3';
}
const { id, title = 'Video', language, headingLevel: H = 'h3' } = Astro.props;
const thumb = id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : '';
---

{
  id ? (
    <div class="video-embed" data-video-id={id} data-video-title={title}>
      <a class="video-embed__link" href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">
        <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" />
        <span class="video-embed__play">
          <Icon name="play" size={34} />
        </span>
        <span class="visually-hidden">Play video: {title}</span>
      </a>
      {language && <p class="video-embed__lang">In {language}. The video loads from YouTube when you press play.</p>}
    </div>
  ) : (
    <div class="video-soon">
      <span class="video-soon__icon">
        <Icon name="play" size={30} />
      </span>
      <H class="video-soon__title">Coming soon</H>
      <p>New videos in Malayalam, with English captions, will appear here.</p>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.video-embed').forEach((wrap) => {
    const link = wrap.querySelector<HTMLAnchorElement>('.video-embed__link');
    const id = wrap.dataset.videoId;
    if (!link || !id) return;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = wrap.dataset.videoTitle || 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'video-embed__frame';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video-embed__link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--navy);
  }
  .video-embed__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .video-embed__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--white);
    display: grid;
    place-items: center;
    padding-left: 4px;
  }
  .video-embed__link:hover .video-embed__play {
    background: var(--teal-dark);
  }
  .video-embed :global(.video-embed__frame) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius);
    display: block;
  }
  .video-embed__lang {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .video-soon {
    aspect-ratio: 16 / 9;
    background: var(--white);
    border: 2px dashed var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-3);
  }
  .video-soon__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--teal-tint);
    color: var(--teal-dark);
    display: grid;
    place-items: center;
    padding-left: 3px;
    margin-bottom: 0.75rem;
  }
  .video-soon__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.4rem;
  }
  .video-soon p {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  @media (max-width: 479.98px) {
    .video-soon {
      aspect-ratio: auto;
      min-height: 220px;
    }
  }
</style>
