---
/** Native <details> FAQ. The same data feeds the FAQPage schema, so visible text and schema match exactly. */
import SectionHeading from './SectionHeading.astro';
interface Props {
  faqs: { question: string; answer: string }[];
  heading?: string;
}
const { faqs, heading = 'Common questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq" aria-labelledby="faq-heading">
      <SectionHeading id="faq-heading">{heading}</SectionHeading>
      <div class="faq__list">
        {faqs.map((f) => (
          <details>
            <summary>
              <h3>{f.question}</h3>
            </summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq {
    margin-top: var(--space-5);
  }
  .faq__list {
    display: grid;
    gap: 0.75rem;
    max-width: 820px;
  }
  details {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 3.25rem 1rem 1.25rem;
    position: relative;
    min-height: var(--tap);
    border-radius: var(--radius);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--teal-dark);
    line-height: 1;
  }
  details[open] summary::after {
    content: '\2212';
  }
  summary h3 {
    font-size: 1.1875rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    display: inline;
  }
  details p {
    margin: 0;
    padding: 0 1.25rem 1.25rem;
  }
</style>
