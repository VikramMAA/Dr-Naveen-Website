---
/** Shoulder signs (follows NHS guidance): teal checks, plus one red urgent line. */
import Icon from './Icon.astro';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: H = 'h3' } = Astro.props;
---

<aside class="shoulder-signs">
  <H class="shoulder-signs__heading">See a doctor if:</H>
  <ul class="shoulder-signs__list">
    <li><Icon name="check-circle" size={28} /> Shoulder pain has not improved after 2 weeks</li>
    <li><Icon name="check-circle" size={28} /> It stops you sleeping, dressing or lifting your arm</li>
  </ul>
  <p class="shoulder-signs__urgent">
    <span class="shoulder-signs__urgent-icon"><Icon name="warning" size={28} /></span>
    <strong>Sudden severe pain, or you cannot move the arm: get help urgently.</strong>
  </p>
</aside>

<style>
  .shoulder-signs {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    max-width: 760px;
  }
  .shoulder-signs__heading {
    font-size: var(--fs-h3);
    margin-bottom: 0.75rem;
  }
  .shoulder-signs__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .shoulder-signs__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-weight: 700;
  }
  .shoulder-signs__list li + li {
    margin-top: 0.6rem;
  }
  .shoulder-signs__list :global(.icon) {
    color: var(--teal);
    margin-top: 0.1rem;
  }
  .shoulder-signs__urgent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 3px solid var(--red);
    border-radius: var(--radius);
    max-width: none;
  }
  .shoulder-signs__urgent-icon {
    color: var(--red);
    display: inline-flex;
  }
</style>
