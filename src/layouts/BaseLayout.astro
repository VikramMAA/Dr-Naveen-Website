---
import '@fontsource-variable/manrope';
import '@fontsource/noto-sans-malayalam/malayalam-500.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { site, absoluteUrl } from '../config/site';
import { physicianSchema, websiteSchema, breadcrumbSchema, type JsonLd } from '../lib/schema';
import { ogPath } from '../lib/og';

interface Props {
  /** Full <title> text */
  title: string;
  description: string;
  /** Path of this page, e.g. "/about" */
  path: string;
  breadcrumbs?: Crumb[];
  schema?: JsonLd[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, path, breadcrumbs, schema = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(ogPath(path === '/404' ? '/' : path));

const graph: JsonLd[] = [physicianSchema(absoluteUrl(ogPath('/'))), websiteSchema()];
if (breadcrumbs && breadcrumbs.length > 1) graph.push(breadcrumbSchema(breadcrumbs));
graph.push(...schema);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

const analytics = site.analytics;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#14213D" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${site.name} | ${site.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <noscript>
      <style>
        .nav-toggle { display: none !important; }
        .primary-nav { display: block !important; position: static !important; box-shadow: none !important; }
        .site-header__inner { flex-wrap: wrap; }
        .knee-map__prompt, .knee-map__btn { display: none !important; }
        .knee-map__zones li { display: grid !important; margin-bottom: 0.75rem; }
        .print-button { display: none !important; }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={jsonLd} />

    {
      analytics.provider === 'plausible' && analytics.plausibleDomain && (
        <script is:inline defer data-domain={analytics.plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={path} />
    <main id="main" tabindex="-1">
      {
        breadcrumbs && breadcrumbs.length > 1 && (
          <div class="container">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
